# --- Greece marketplace platform (Phase 1) ---------------------------------
# Neon Postgres connection string (Neon dashboard -> Connection Details).
DATABASE_URL=
# Shared secret between this app and modal/ for internal moderation/AI-usage
# API routes. Same value must be set in modal/.env as MODAL_INTERNAL_API_KEY.
INTERNAL_ADMIN_API_KEY=
# Signs end-user session cookies for magic-link auth. 32+ random chars.
AUTH_SESSION_SECRET=

# --- MCP capability layer (src/mcp/, src/app/api/mcp/) ----------------------
# Both unset by default: /api/mcp exists and is spec-compliant, but rejects
# every caller (403) until you deliberately provision one external client —
# external exposure is opt-in, not on by default. Read-only scopes only in
# v1 (properties:read, professionals:read, call-booking:read); see
# src/lib/mcp-external-auth.ts.
MCP_EXTERNAL_CLIENT_ID=
MCP_EXTERNAL_CLIENT_KEY=
