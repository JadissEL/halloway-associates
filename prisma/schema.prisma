// Halloway & Associates — Greece AI Platform
// Prisma schema (Phase 1). See PLATFORM.md at repo root for the architecture
// this schema implements (Request Rooms, moderation, multilingual knowledge, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & roles
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  PROPERTY_OWNER
  AGENT
  BUSINESS
  PROFESSIONAL
  ADMINISTRATOR
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  role            Role     @default(CUSTOMER)
  preferredLocale String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  magicLinkTokens MagicLinkToken[]
  requestRooms    RequestRoom[]
  notifications   Notification[]
  savedItems      SavedItem[]
  properties      Property[]
  callBookings    CallBooking[]
  requestMessages RequestMessage[]
  mediaAssets     MediaAsset[]
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Request Rooms — the generic "bundle everything about this request" entity
// (spec section 11.1). Every workflow (lawyer request, property search,
// arrival call, ...) creates one of these.
// ---------------------------------------------------------------------------

enum RequestRoomType {
  LAWYER
  ACCOUNTANT
  ARCHITECT_ENGINEER
  PROPERTY_SEARCH
  PROPERTY_SALE
  RENOVATION
  MOVING
  CLEANING
  ARRIVAL_CALL
  OTHER
}

enum RequestRoomStatus {
  REQUESTED
  UNDER_REVIEW
  MATCHING
  PROFESSIONAL_SELECTED
  APPOINTMENT_PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RequestRoom {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           RequestRoomType
  status         RequestRoomStatus @default(REQUESTED)
  // Structured, language-neutral representation of the request (spec section 15) —
  // e.g. { category, location, budgetMax, currency, moveInDate, ... }
  structuredData Json              @default("{}")
  professionalId String?
  professional   Professional?     @relation(fields: [professionalId], references: [id])
  propertyId     String?
  property       Property?         @relation(fields: [propertyId], references: [id])
  callBookingId  String?           @unique
  callBooking    CallBooking?      @relation(fields: [callBookingId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  messages      RequestMessage[]
  attachments   RequestAttachment[]
  statusEvents  StatusEvent[]
  notifications Notification[]

  @@index([userId])
  @@index([type, status])
}

enum MessageSender {
  USER
  AI
  PROFESSIONAL
  SYSTEM
}

model RequestMessage {
  id             String        @id @default(cuid())
  roomId         String
  room           RequestRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderType     MessageSender
  senderUserId   String?
  senderUser     User?         @relation(fields: [senderUserId], references: [id])
  content        String
  // BCP-47 code of the language the message was actually written in
  // (spec section 16 — never silently overwrite the original).
  originalLocale String
  // { "<locale>": "translated text" } — populated on demand, original always kept.
  translations   Json?
  createdAt      DateTime      @default(now())

  @@index([roomId])
}

model RequestAttachment {
  id         String      @id @default(cuid())
  roomId     String
  room       RequestRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url        String
  filename   String
  mimeType   String
  uploadedBy String
  createdAt  DateTime    @default(now())

  @@index([roomId])
}

model StatusEvent {
  id         String      @id @default(cuid())
  roomId     String
  room       RequestRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime    @default(now())

  @@index([roomId])
}

model Notification {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestRoomId String?
  requestRoom   RequestRoom? @relation(fields: [requestRoomId], references: [id])
  message       String
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([userId, isRead])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

// ---------------------------------------------------------------------------
// Property (rooms/apartments/houses) — reference vertical #1
// ---------------------------------------------------------------------------

enum PropertyType {
  ROOM
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
}

enum ListingIntent {
  RENT
  SALE
}

enum ModerationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
  FLAGGED
  ESCALATED
}

model Property {
  id            String           @id @default(cuid())
  ownerId       String?
  owner         User?            @relation(fields: [ownerId], references: [id])
  title         String
  description   String
  propertyType  PropertyType
  listingIntent ListingIntent
  city          String
  area          String?
  // Square metres — added alongside the AI draft workflow (mcp/tools/listings.ts)
  // after live testing showed the model conflating "85 square meters" with the
  // `area` field above (a neighbourhood/district name, not a size) since there
  // was nowhere else to put it. The manual PropertyForm.tsx doesn't collect
  // this yet either — a real, pre-existing gap the AI path just surfaced first.
  livingAreaSqm Int?
  priceAmount   Int
  currency      String           @default("EUR")
  bedrooms      Int?
  furnished     Boolean?
  images        String[]
  status        ModerationStatus @default(PENDING_REVIEW)
  isDemo        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  requestRooms    RequestRoom[]
  moderationItems ModerationItem[]
  media           MediaAsset[]

  @@index([status])
  @@index([city, propertyType, listingIntent])
}

// ---------------------------------------------------------------------------
// Media intelligence layer — the AI concierge's multimodal upload pipeline
// (chat attachments: images/audio/video/documents). Generic across listing
// types on purpose (see ListingKind): today only PROPERTY has a real backing
// table to attach to, but the model itself doesn't hardcode that — a future
// vertical (vehicle/business/...) attaches by adding its own nullable FK
// column here, the same way propertyId does, not by duplicating this table.
//
// Blobs are stored in Postgres (`data Bytes`) rather than S3/R2/Blob
// storage: this platform has no object-storage credentials provisioned
// today (confirmed against .env.local/.env.example — Neon Postgres + Groq +
// Resend only), and provisioning one is a real infra/cost decision for a
// human to make, not something to silently add. Images are re-encoded to
// WebP and capped at 2000px on the long edge before storage specifically to
// keep this option viable (see src/lib/media/storage.ts) — swapping the
// storage backend later only means rewriting that one module's save/read
// functions, everything else (schema, API, MCP tools, UI) is backend-agnostic.
enum ListingKind {
  PROPERTY
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum MediaProcessingStatus {
  UPLOADED
  PROCESSING
  ANALYZED
  FAILED
}

model MediaAsset {
  id        String  @id @default(cuid())
  // Every upload starts scoped to the chat session it came from (spec
  // section 13, "multimodal context") — sessionId is the same anonymous id
  // ConversationContext.tsx already generates client-side. userId is set
  // only once we know who's signed in; a listing draft is created and
  // media gets linked to it via listingKind/propertyId once the AI (or the
  // user) confirms which listing this media belongs to.
  sessionId String
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  listingKind ListingKind?
  propertyId  String?
  property    Property?    @relation(fields: [propertyId], references: [id])

  mediaKind        MediaKind
  originalFilename String
  mimeType         String
  sizeBytes        Int
  data             Bytes
  checksum         String
  widthPx          Int?
  heightPx         Int?
  durationMs       Int?

  processingStatus MediaProcessingStatus @default(UPLOADED)
  errorMessage     String?

  // AI detections — a taxonomy category (see src/lib/media/taxonomy.ts),
  // never presented to the user as fact without its confidence (spec
  // section 9/23: AI-detected is not the same provenance tier as
  // user-confirmed until userConfirmed flips true).
  detectedCategory    String?
  detectedSubcategory String?
  categoryConfidence  Float?
  extractedText       String?
  transcript          String?
  aiDescription       String?
  qualityScore        Float?
  blurScore           Float?
  orientation         String?
  perceptualHash      String?
  duplicateGroup      String?
  userConfirmed       Boolean @default(false)
  // Catch-all for detection detail that doesn't warrant its own column yet
  // (entities extracted from a voice message, OCR line items, etc.) —
  // structured, still provenance-tagged inside, never freeform prose.
  aiMetadata          Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([propertyId])
  @@index([checksum])
  @@index([duplicateGroup])
  @@index([processingStatus])
}

// ---------------------------------------------------------------------------
// Professionals & partner platforms (spec sections 5.1, 9, and the
// shopthebarber.app requirement — never recommend a competing platform).
// ---------------------------------------------------------------------------

enum ProfessionalCategory {
  LAWYER
  ACCOUNTANT
  ARCHITECT
  ENGINEER
  CLEANER
  MOVER
  PROPERTY_MANAGER
  BARBER_GROOMING
  OTHER
}

model Professional {
  id                String               @id @default(cuid())
  name              String
  category          ProfessionalCategory
  languages         String[]
  bio               String
  // True for approved external platforms we route users to instead of building
  // our own workflow (e.g. shopthebarber.app for grooming/barber bookings).
  isPartnerPlatform Boolean              @default(false)
  externalUrl       String?
  isDemo            Boolean              @default(false)
  status            ModerationStatus     @default(APPROVED)
  createdAt         DateTime             @default(now())

  requestRooms RequestRoom[]

  @@index([category])
}

// ---------------------------------------------------------------------------
// Arrival & Information Calls (spec section 12)
// ---------------------------------------------------------------------------

enum CallType {
  ORIENTATION
  RELOCATION
  PROPERTY
  BUSINESS
  WORK_LIFE
  INVESTMENT
  CUSTOM
  UNSURE
}

model AvailabilitySlot {
  id          String       @id @default(cuid())
  callType    CallType?
  startTime   DateTime
  endTime     DateTime
  isBooked    Boolean      @default(false)
  callBooking CallBooking?

  @@index([startTime, isBooked])
}

model CallBooking {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  callType          CallType
  reason            String?
  topics            String[]
  preferredLanguage String
  countryOfOrigin   String?
  arrivalDate       DateTime?
  cityOfInterest    String?
  slotId            String?           @unique
  slot              AvailabilitySlot? @relation(fields: [slotId], references: [id])
  createdAt         DateTime          @default(now())

  requestRoom RequestRoom?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Moderation & Trust layer (spec section 6) — generic across content types.
// ---------------------------------------------------------------------------

enum ModeratedContentType {
  PROPERTY
  PROFESSIONAL
  JOB
  VEHICLE
  BUSINESS
  OFFER
  ARTICLE
}

enum ModerationAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  SUSPEND
  FLAG
  ESCALATE
}

model ModerationItem {
  id            String               @id @default(cuid())
  contentType   ModeratedContentType
  propertyId    String?
  property      Property?            @relation(fields: [propertyId], references: [id])
  status        ModerationStatus     @default(PENDING_REVIEW)
  lastAction    ModerationAction?
  moderatorNote String?
  createdAt     DateTime             @default(now())
  decidedAt     DateTime?

  @@index([contentType, status])
}

// ---------------------------------------------------------------------------
// Knowledge layer (spec sections 8, 13, 14) — the AI's structured,
// source-attributed knowledge base. Never a single blob.
// ---------------------------------------------------------------------------

enum KnowledgeCategory {
  PLATFORM
  GREECE
  PROFESSIONALS
  CALCULATORS
  ARTICLES
  OPERATIONS
}

model KnowledgeArticle {
  id              String            @id @default(cuid())
  category        KnowledgeCategory
  slug            String            @unique
  canonicalLocale String            @default("en")
  canonicalText   String
  // { "<locale>": "translated text" }
  translations    Json              @default("{}")
  sourceUrl       String?
  effectiveDate   DateTime?
  lastReviewed    DateTime?
  version         Int               @default(1)
  isApproved      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([category, isApproved])
}

// ---------------------------------------------------------------------------
// AI usage tracking (spec section 18) — token/cost/layer accounting.
// ---------------------------------------------------------------------------

enum AiLayer {
  DETERMINISTIC
  RETRIEVAL
  LIGHT_AI
  REASONING
}

model AiUsageLog {
  id               String   @id @default(cuid())
  sessionId        String
  userId           String?
  layer            AiLayer
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  toolCalls        Json?
  costEstimateUsd  Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([layer])
}

// ---------------------------------------------------------------------------
// MCP capability layer audit trail — one row per MCP tool call, both proposed
// (pre-confirmation) and executed. Deliberately NOT a foreign key to the
// resource it touches (unlike ModerationItem.propertyId): an audit row must
// keep meaning even if the underlying Property/RequestRoom/etc. is later
// deleted, so resourceId is a soft, unconstrained reference. This is a
// different concern from AiUsageLog (token/cost/layer accounting, which
// already drops args/results) — this table exists specifically to answer
// "who did what, to what, was it authorized, was it confirmed."
// ---------------------------------------------------------------------------

enum McpResourceType {
  PROPERTY
  PROFESSIONAL
  REQUEST_ROOM
  CALL_BOOKING
}

enum McpOutcome {
  SUCCESS
  DENIED
  ERROR
  PENDING_CONFIRMATION
}

model McpAuditLog {
  id           String           @id @default(cuid())
  // Who: null actorUserId means an anonymous/read-only caller (e.g. a public
  // search) — still logged, just with no identity attached.
  actorUserId  String?
  actorRole    Role?
  // Which transport/caller: "internal-concierge" for the platform's own AI,
  // or an external MCP client's configured clientId.
  clientId     String
  toolName     String
  resourceType McpResourceType?
  resourceId   String?
  inputArgs    Json
  authorized   Boolean
  confirmed    Boolean?
  outcome      McpOutcome
  errorMessage String?
  latencyMs    Int              @default(0)
  createdAt    DateTime         @default(now())

  @@index([toolName, createdAt])
  @@index([actorUserId])
  @@index([outcome])
}
